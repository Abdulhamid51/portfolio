# Ishlab chiqarish uchun namunaviy sozlamalar.
# Bu faylni `.env` deb nusxalang va qiymatlarni to'ldiring (`.env` git'ga tushmaydi).

DJANGO_DEBUG=0
# Kalitni shu buyruq bilan yarating:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

DJANGO_ALLOWED_HOSTS=oldfox.uz,www.oldfox.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://oldfox.uz,https://www.oldfox.uz

# HTTPS ga majburiy yo'naltirish (nginx o'zi qilsa, 0 qo'ying)
DJANGO_SSL_REDIRECT=1

# Ma'lumotlar bazasi va yuklangan fayllar joyi
DJANGO_DB_PATH=/var/www/oldfox/db.sqlite3
DJANGO_MEDIA_ROOT=/var/www/oldfox/media

# Chegaralar
DJANGO_CONTACT_RATE_LIMIT=5
DJANGO_LOGIN_RATE_LIMIT=8

# --- Gemini (maqola matnini imlo va format jihatidan tozalash) ---
# Kalitni https://aistudio.google.com/apikey dan oling
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=90
DJANGO_ASSIST_RATE_LIMIT=40
